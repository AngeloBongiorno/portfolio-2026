---
// src/components/Hero.astro
---

<section class="hero" id="hero">
  <div class="hero-inner">
    <p class="eyebrow">Angelo Bongiorno - Machine Learning & Software Engineer</p>
    <h1>
      Building<br />
      your next <span class="accent">intelligent</span><br />
      system.
    </h1>
    <p class="desc">
      I design and develop AI-driven applications, with an engineering mindset.</p>
    <div class="cta-row">
      <a href="#projects" class="btn-primary">View projects</a>
      <a href="/portfolio-2026/cv.pdf" class="btn-secondary" target="_blank">Download CV</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 2rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    max-width: 1580px;
    padding-left: 5em;
  }

  .eyebrow {
    font-family: 'Geist Mono Variable', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .accent {
    color: var(--accent);
  }

  .desc {
    font-size: 1.0625rem;
    color: var(--text-dim);
    line-height: 1.75;
    max-width: 480px;
    margin-bottom: 2.5rem;
    /*white-space: nowrap;*/
  }

  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    transition: opacity 0.2s ease;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-secondary {
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.875rem;
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: var(--muted);
    color: var(--text);
  }
</style>
