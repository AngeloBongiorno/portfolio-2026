---
// src/components/Skills.astro
const skillGroups = [
    {
        category: 'Artificial Intelligence & Data Science',
        skills: ['Training & fine-tuning', 'Retrieval Augmented Generation', 'Prompt Engineering', 'Databases', 'Data Analysis']
        },
    {
        category: 'Frameworks & Libraries',
        skills: ['PyTorch', 'Pandas', 'NumPy', 'Scikit-learn', 'LangChain']

    },
    {
        category: 'Programming Languages',
        skills: ['Python', 'Rust', 'JavaScript', 'TypeScript', 'SQL']
    },
    {
        category: 'Tools & Platforms',
        skills: ['Git', 'Docker', 'Linux', 'Large Language Models']
    }
];
---


<section class="skills" id="skills">
  <div class="inner">
    <div class="section-header">
      <span class="label">What I work with</span>
      <h2>Skills & Tools</h2>
    </div>
    <div class="groups">
      {skillGroups.map(group => (
        <div class="group">
          <h3>{group.category}</h3>
          <ul>
            {group.skills.map(skill => (
              <li>{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    padding: 6rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .label {
    font-family: 'Geist Mono Variable', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 2rem;
  }

  h3 {
    font-family: 'Geist Mono Variable', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: min(10px, 5%);
  }

  li {
    font-size: 0.9375rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.2s ease;
  }

  li::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  li:hover {
    color: var(--text);
  }
</style>
