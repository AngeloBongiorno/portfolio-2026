---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Angelo — ML & SW Engineer",
  description = "Building your next intelligent system.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '@fontsource-variable/geist';
  @import '@fontsource-variable/geist-mono';

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg:        #0a0a0a;
    --surface:   #111111;
    --border:    #1e1e1e;
    --muted:     #555555;
    --text:      #f0f0ec;
    --text-dim:  #888888;
    /*--accent:    #fff70d;*/
    --accent:    #a3e635;
    --accent-fg: #0a0a0a;
    --in-progress: #81658d87;
}

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Geist Variable', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: var(--accent);
    color: var(--accent-fg);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  code, .mono {
    font-family: 'Geist Mono Variable', monospace;
  }
</style>
